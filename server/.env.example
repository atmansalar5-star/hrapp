# فهرست مرجع کلیدهای محیطی سرور (نمونه — رمز واقعی اینجا نوشته نمی‌شود).
#
# رمزها دیگر روی دیسک نگه‌داری نمی‌شوند: مقادیر واقعی در Infisical ثبت می‌شوند و در زمان
# اجرا با «infisical run --env=dev -- <دستور>» به‌صورت متغیر محیطی تزریق می‌گردند؛ فایل
# .infisical.json فقط پیوند پروژه را نگه می‌دارد و رمزی ندارد. این فایل را به .env کپی نکنید.

# کلید امضای توکن (HS256). حداقل ۱۶ بایت؛ در استقرار واقعی باید یک مقدار تصادفی بلند باشد.
# اگر تنظیم نشود، سرور برای اجرای توسعه یک کلید موقت می‌سازد و هشدار می‌دهد.
HRMS_JWT_SECRET=

# فهرست ماژول‌های فعال با کاما؛ خالی یعنی همهٔ ۱۵ ماژول فعال باشند.
# نمونه برای استقراری که فقط بخشی از ماژول‌ها را خریده است:
# HRMS_MODULES=employee,dashboard,settings
HRMS_MODULES=

# اتصال دیتابیس (برای آداپتور Postgres در فاز بعد). مهاجرت‌ها در server/migrations و
# server/internal/modules/*/migrations قرار دارند.
# HRMS_DATABASE_URL=postgres://hrms:secret@localhost:5432/hrms?sslmode=disable

# صندوق خروجی رخداد برای یکپارچه‌سازی بیرونی (n8n، پیامک، گزارش‌ساز).
# خالی بودن نشانی یعنی ارسال خاموش: رخدادها در جدول hr_platform.event_outbox ثبت
# می‌شوند ولی چیزی به شبکه نمی‌رود. جزئیات: docs/integration-n8n-fa.md
# HRMS_WEBHOOK_URL=http://127.0.0.1:5678/webhook/hrms-events
# HRMS_WEBHOOK_SECRET=
# HRMS_WEBHOOK_INTERVAL=15s
