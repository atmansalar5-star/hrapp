# متغیرهای یکپارچه‌سازی n8n با سامانهٔ منابع انسانی
#
# این فایل را به `.env` کنار همین فایل کپی و مقدارها را پر کنید؛ فایل `.env` کامیت
# نمی‌شود (در .gitignore هست). هیچ کلیدی در مخزن نمی‌نشیند.

# کلید مشترک امضای HMAC. باید دقیقاً همان مقدار HRMS_WEBHOOK_SECRET در سرور باشد.
HRMS_WEBHOOK_SECRET=replace-with-a-long-random-string

# نشانی API سامانه (اجرای محلی روی تسک «HRMS Server»).
HRMS_API_BASE=http://127.0.0.1:8099

# حساب سرویس با کمترین دسترسی. گردش‌کار در هر اجرا با همین حساب وارد می‌شود و توکن
# ۳۰ دقیقه‌ای همان اجرا را به کار می‌برد؛ هیچ توکن ثابتی ذخیره نمی‌شود.
HRMS_API_USER=hr.spec
HRMS_API_PASS=