{
  "name": "HRMS — رویدادهای سامانه",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hrms-events",
        "responseMode": "onReceived",
        "options": {
          "rawBody": true,
          "responseData": "‏رخداد دریافت شد"
        }
      },
      "id": "wh-hrms-1",
      "name": "Webhook سامانهٔ منابع انسانی",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -460,
        120
      ],
      "webhookId": "hrms-events",
      "notes": "سرور رویدادها را با امضای HMAC به همین نشانی می‌فرستد (HRMS_WEBHOOK_URL)."
    },
    {
      "parameters": {
        "jsCode": "// بازبینی امضای HMAC و تازگی مُهر زمانی؛ بدنهٔ دست‌کاری‌شده رد می‌شود.\n//\n// چرا در کد و نه در نود آماده: امضا روی «بایت‌های خام» بدنه محاسبه شده و اگر بدنه\n// یک‌بار به JSON تبدیل و دوباره سریال‌شده شود، ترتیب کلیدها و فاصله‌ها عوض می‌شود و\n// امضا دیگر معنا ندارد. پس همان بدنهٔ خام خوانده می‌شود.\nconst crypto = require('crypto');\n\nconst item = $input.first();\nconst headers = (item.json && item.json.headers) || {};\n\nlet raw = '';\nif (item.binary && item.binary.data) {\n  raw = Buffer.from(item.binary.data.data, 'base64').toString('utf8');\n} else if (typeof item.json.body === 'string') {\n  raw = item.json.body;\n} else if (item.json.body) {\n  raw = JSON.stringify(item.json.body);\n}\n\nconst secret = $env.HRMS_WEBHOOK_SECRET || '';\nconst ts = String(headers['x-hrms-timestamp'] || '');\nconst signature = String(headers['x-hrms-signature'] || '');\n\nif (!secret) {\n  throw new Error('HRMS_WEBHOOK_SECRET تنظیم نشده است؛ بازبینی امضا ممکن نیست.');\n}\nif (!raw || !ts || !signature) {\n  throw new Error('بدنه یا سرآیندهای امضا در درخواست نیست.');\n}\n\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret).update(ts + '.' + raw).digest('hex');\nconst same = expected.length === signature.length &&\n  crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(signature));\n\n// پنج دقیقه اختلاف مجاز است تا بازپخش (replay) بدنهٔ قدیمی ممکن نباشد.\nconst skew = Math.abs(Math.floor(Date.now() / 1000) - Number(ts));\nif (skew > 300) {\n  throw new Error('مُهر زمانی رخداد قدیمی است (' + skew + ' ثانیه)؛ درخواست رد شد.');\n}\nif (!same) {\n  throw new Error('امضای رخداد نامعتبر است؛ درخواست رد شد.');\n}\n\nconst event = JSON.parse(raw);\nreturn [{ json: event }];"
      },
      "id": "code-verify-1",
      "name": "بازبینی امضا",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        120
      ],
      "notes": "NODE_FUNCTION_ALLOW_BUILTIN=crypto باید تنظیم باشد (اسکریپت اجرای n8n آن را می‌گذارد)."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
